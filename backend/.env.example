# ==============================================================================
# Plantilla de variables de entorno para el Backend de la plataforma SAIP
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renombralo como '.env' en este mismo directorio (backend/.env).
# 2. Llena las variables con los valores reales de tu entorno de staging/desarrollo.
# 3. NUNCA agregues ni comitees el archivo '.env' al control de versiones (Git).
#    Ya esta debidamente configurado y excluido en el archivo '.gitignore' del monorepo.
# ==============================================================================

# Perfil activo de Spring Boot (ejemplo: staging)
SPRING_PROFILES_ACTIVE=

# Configuracion de Almacenamiento S3 (Supabase Storage)
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_BUCKET_NAME=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
AWS_REGION=
