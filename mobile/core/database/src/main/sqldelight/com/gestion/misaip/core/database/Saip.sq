-- =============================================================================
-- SISTEMA SAIP - ESQUEMA DE BASE DE DATOS SQLDelight
-- Modelo Normalizado para aplicación Android Offline-First
-- =============================================================================

-- =============================================================================
-- TABLA: Usuario
-- =============================================================================
CREATE TABLE Usuario (
    id TEXT NOT NULL PRIMARY KEY,
    tipo TEXT NOT NULL,
    nombre TEXT NOT NULL,
    dni TEXT,
    usuario TEXT,
    email TEXT,
    telefono TEXT,
    direccion TEXT,
    entidad TEXT,
    entidadId TEXT,
    cargo TEXT,
    fechaRegistro INTEGER NOT NULL,
    passwordHash TEXT,
    estaActivo INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    sincronizado INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    ultimaModificacion INTEGER NOT NULL
);

-- Índices para Usuario
CREATE INDEX idx_usuario_tipo ON Usuario(tipo);
CREATE INDEX idx_usuario_dni ON Usuario(dni);
CREATE INDEX idx_usuario_entidadId ON Usuario(entidadId);

-- =============================================================================
-- TABLA: EntidadPublica
-- =============================================================================
CREATE TABLE EntidadPublica (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    sector TEXT NOT NULL,
    siglas TEXT,
    ruc TEXT,
    direccion TEXT,
    telefono TEXT,
    email TEXT,
    sitioWeb TEXT,
    nivelGobierno TEXT NOT NULL DEFAULT 'NACIONAL',
    activa INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    sincronizado INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    ultimaModificacion INTEGER NOT NULL
);

-- Índices para EntidadPublica
CREATE INDEX idx_entidad_sector ON EntidadPublica(sector);
CREATE INDEX idx_entidad_activa ON EntidadPublica(activa);

-- =============================================================================
-- TABLA: Solicitud
-- =============================================================================
CREATE TABLE Solicitud (
    id TEXT NOT NULL PRIMARY KEY,
    expediente TEXT NOT NULL UNIQUE,
    tipo TEXT NOT NULL,
    entidad TEXT NOT NULL,
    entidadId TEXT NOT NULL,
    usuarioId TEXT NOT NULL,
    -- Datos del solicitante (desnormalizados para offline)
    solicitanteNombre TEXT NOT NULL,
    solicitanteDni TEXT NOT NULL,
    solicitanteEmail TEXT NOT NULL,
    solicitanteTelefono TEXT NOT NULL,
    solicitanteDireccion TEXT NOT NULL,
    -- Contenido de la solicitud
    asunto TEXT NOT NULL,
    descripcion TEXT NOT NULL,
    fechaCreacion INTEGER NOT NULL,
    fechaLimite INTEGER NOT NULL,
    estado TEXT NOT NULL,
    diasRestantes INTEGER,
    prioridad TEXT NOT NULL DEFAULT 'MEDIA',
    silencioAdministrativo INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    -- Respuesta de la entidad (nullable)
    respuestaFecha INTEGER,
    respuestaFuncionario TEXT,
    respuestaTipo TEXT,
    respuestaFundamentacion TEXT,
    respuestaArchivos TEXT, -- JSON array serializado
    -- Timeline (JSON serializado)
    timeline TEXT NOT NULL DEFAULT '[]',
    -- Control de sincronización
    sincronizado INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    pendienteSubida INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    ultimaModificacion INTEGER NOT NULL,
    consentimientoDatosPersonales INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    canalNotificacion TEXT,
    -- Metadatos livianos; nunca contiene binarios ni claves del storage
    documentosMetadata TEXT NOT NULL DEFAULT '[]',
    respuestaId TEXT,
    respuestaDocumentosMetadata TEXT NOT NULL DEFAULT '[]',
    -- Foreign keys
    FOREIGN KEY (usuarioId) REFERENCES Usuario(id),
    FOREIGN KEY (entidadId) REFERENCES EntidadPublica(id)
);

-- Índices para Solicitud
CREATE INDEX idx_solicitud_expediente ON Solicitud(expediente);
CREATE INDEX idx_solicitud_usuarioId ON Solicitud(usuarioId);
CREATE INDEX idx_solicitud_entidadId ON Solicitud(entidadId);
CREATE INDEX idx_solicitud_estado ON Solicitud(estado);
CREATE INDEX idx_solicitud_fechaCreacion ON Solicitud(fechaCreacion);
CREATE INDEX idx_solicitud_pendienteSubida ON Solicitud(pendienteSubida);

-- =============================================================================
-- TABLA: Apelacion
-- =============================================================================
CREATE TABLE Apelacion (
    id TEXT NOT NULL PRIMARY KEY,
    expediente TEXT NOT NULL UNIQUE,
    expedienteSAIP TEXT,
    solicitudId TEXT,
    usuarioId TEXT NOT NULL,
    -- Datos del apelante
    apelanteNombre TEXT NOT NULL,
    apelanteDni TEXT NOT NULL,
    apelanteEmail TEXT NOT NULL,
    -- Datos de la apelación
    entidad TEXT NOT NULL,
    entidadId TEXT NOT NULL,
    asunto TEXT NOT NULL,
    fundamentoLegal TEXT NOT NULL,
    exposicionHechos TEXT NOT NULL,
    pretension TEXT NOT NULL,
    fechaPresentacion INTEGER NOT NULL,
    estado TEXT NOT NULL,
    funcionarioTTAIP TEXT,
    -- Calificaciones (JSON serializado)
    primeraCalificacion TEXT,
    segundaCalificacion TEXT,
    -- Subsanación (JSON serializado)
    subsanacion TEXT,
    -- Timeline (JSON serializado)
    timeline TEXT NOT NULL DEFAULT '[]',
    -- Otros campos
    diasHabiles INTEGER,
    diasRestantes INTEGER,
    informeOralSolicitado INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    timerPausado INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    fechaElevacion INTEGER,
    elevacionExtemporanea INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    -- Origen externo y elevación formal
    tipoOrigen TEXT NOT NULL DEFAULT 'SAIP_INTERNA',
    numeroSolicitudExterna TEXT,
    tipoDenegatoria TEXT,
    fechaPresentacionSolicitudExterna TEXT,
    fechaRespuestaEntidad TEXT,
    resumenSolicitudOriginal TEXT,
    resumenRespuestaEntidad TEXT,
    referenciaDocumentoSolicitud TEXT,
    referenciaCargoRecepcion TEXT,
    referenciaRespuestaEntidad TEXT,
    evidenciaSilencioAdministrativo TEXT,
    observacion TEXT,
    estadoElevacion TEXT,
    fechaLimiteElevacion TEXT,
    referenciaCargoPresentacionElevacion TEXT,
    referenciaExpedienteElevado TEXT,
    referenciaPruebaOmision TEXT,
    -- Control de sincronización
    sincronizado INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    pendienteSubida INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    ultimaModificacion INTEGER NOT NULL,
    -- Metadatos livianos; nunca contiene binarios ni claves del storage
    documentosMetadata TEXT NOT NULL DEFAULT '[]',
    -- Foreign keys
    FOREIGN KEY (usuarioId) REFERENCES Usuario(id)
);

-- Índices para Apelacion
CREATE INDEX idx_apelacion_expediente ON Apelacion(expediente);
CREATE INDEX idx_apelacion_expedienteSAIP ON Apelacion(expedienteSAIP);
CREATE INDEX idx_apelacion_solicitudId ON Apelacion(solicitudId);
CREATE INDEX idx_apelacion_usuarioId ON Apelacion(usuarioId);
CREATE INDEX idx_apelacion_estado ON Apelacion(estado);
CREATE INDEX idx_apelacion_tipoOrigen ON Apelacion(tipoOrigen);
CREATE INDEX idx_apelacion_estadoElevacion ON Apelacion(estadoElevacion);
CREATE INDEX idx_apelacion_pendienteSubida ON Apelacion(pendienteSubida);

-- =============================================================================
-- TABLA: Sesion (para gestión de sesión local)
-- =============================================================================
CREATE TABLE Sesion (
    id INTEGER NOT NULL PRIMARY KEY,
    usuarioId TEXT NOT NULL,
    token TEXT,
    fechaInicio INTEGER NOT NULL,
    fechaExpiracion INTEGER,
    activa INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    FOREIGN KEY (usuarioId) REFERENCES Usuario(id)
);

-- =============================================================================
-- TABLA: SyncLog (para control de sincronización)
-- =============================================================================
CREATE TABLE SyncLog (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    tabla TEXT NOT NULL,
    registroId TEXT NOT NULL,
    operacion TEXT NOT NULL, -- INSERT, UPDATE, DELETE
    timestamp INTEGER NOT NULL,
    sincronizado INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

CREATE INDEX idx_synclog_pendiente ON SyncLog(sincronizado, timestamp);

-- =============================================================================
-- TABLA: Contadores (para generación de expedientes offline)
-- =============================================================================
CREATE TABLE Contadores (
    id TEXT NOT NULL PRIMARY KEY,
    valor INTEGER NOT NULL,
    ultimaModificacion INTEGER NOT NULL
);

-- Insertar contadores iniciales
INSERT INTO Contadores (id, valor, ultimaModificacion) VALUES ('SAIP', 1000, 0);
INSERT INTO Contadores (id, valor, ultimaModificacion) VALUES ('TTAIP', 500, 0);
INSERT INTO Contadores (id, valor, ultimaModificacion) VALUES ('CEDULA', 10000, 0);

-- =============================================================================
-- TABLA: Notificacion (para almacenamiento local de notificaciones)
-- =============================================================================
CREATE TABLE Notificacion (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    tipo TEXT NOT NULL,
    titulo TEXT NOT NULL,
    mensaje TEXT NOT NULL,
    fecha INTEGER NOT NULL,
    leida INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    icono TEXT NOT NULL DEFAULT 'ic_notification',
    color TEXT NOT NULL DEFAULT '#1976D2',
    expediente TEXT,
    usuarioId TEXT NOT NULL,
    sincronizado INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    FOREIGN KEY (usuarioId) REFERENCES Usuario(id)
);

CREATE INDEX idx_notificacion_usuarioId ON Notificacion(usuarioId);
CREATE INDEX idx_notificacion_leida ON Notificacion(leida);
CREATE INDEX idx_notificacion_fecha ON Notificacion(fecha);
