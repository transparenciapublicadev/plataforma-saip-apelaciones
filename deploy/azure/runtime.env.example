# Copy OUTSIDE the checkout. No secrets here: values below are non-secret settings.
# Blank required values intentionally prevent a production start.
COMPOSE_PROJECT_NAME=yaiku-review
POSTGRES_DB=yaiku
POSTGRES_USER=yaiku_dbadmin
DB_APP_USER=yaiku_app
YAIKU_SECRETS_DIR=
YAIKU_TLS_DIR=
YAIKU_BACKUP_DIR=
PUBLIC_ORIGIN=
WEB_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=9443
APP_STORAGE_S3_ENDPOINT=
APP_STORAGE_S3_REGION=
APP_STORAGE_S3_BUCKET=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
APP_NOTIFICATIONS_MAIL_FROM=
# Build on an amd64 workstation/CI, tag immutable releases and fill these tags.
BACKEND_IMAGE=yaiku-backend:prepared
FRONTEND_IMAGE=yaiku-frontend:prepared
PROXY_IMAGE=yaiku-proxy:prepared
